# ===========================================
# LimeSurvey Docker Configuration
# ===========================================
# Copy this file to .env and update values

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
POSTGRES_DB=limesurvey
POSTGRES_USER=limesurvey
# IMPORTANT: Change this password!
POSTGRES_PASSWORD=change_this_secure_password_123

# ===========================================
# LimeSurvey Admin Configuration
# ===========================================
ADMIN_USER=admin
# IMPORTANT: Change this password!
ADMIN_PASSWORD=change_this_admin_password_123
ADMIN_NAME=Survey Administrator
ADMIN_EMAIL=admin@yourdomain.com

# ===========================================
# General Settings
# ===========================================
# Public URL for LimeSurvey (change for production)
PUBLIC_URL=http://localhost:8080

# Port to expose LimeSurvey on host
LIMESURVEY_PORT=8080

# Timezone (https://www.php.net/manual/en/timezones.php)
TZ=Europe/Berlin

# ===========================================
# Email Configuration (Optional)
# ===========================================
# Leave empty to disable email
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=on

# ===========================================
# Backup Configuration
# ===========================================
BACKUP_ENABLED=true
# Cron schedule (default: 2 AM daily)
BACKUP_SCHEDULE=0 2 * * *
# Keep backups for N days
BACKUP_RETENTION_DAYS=30

# ===========================================
# Advanced Settings (Optional)
# ===========================================
# Database table prefix (leave empty for no prefix)
DB_TABLE_PREFIX=

# Debug level (0=off, 1=errors, 2=all)
DEBUG_LEVEL=0
SQL_DEBUG_LEVEL=0

# ===========================================
# Security Notes
# ===========================================
# 1. Never commit .env file to git
# 2. Use strong passwords (min 16 characters)
# 3. Enable SSL/TLS in production
# 4. Restrict database access
# 5. Regular backups are crucial
